[Unit]
Description=Renew Password Recorder IP certificate
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/password-recorder-certbot/bin/certbot renew --cert-name password-recorder-ip --quiet --deploy-hook "/usr/sbin/nginx -t && /usr/bin/systemctl reload nginx"
