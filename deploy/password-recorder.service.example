# Replace YOUR_USER and all project paths before installing this project-specific unit.
[Unit]
Description=Password Recorder HTTPS backend
After=network.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/password_recorder
ExecStart=/home/YOUR_USER/password_recorder/.venv/bin/python -m vault --data-dir /home/YOUR_USER/password_recorder/data --public-origin https://139.224.25.251
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/YOUR_USER/password_recorder/data

[Install]
WantedBy=multi-user.target
